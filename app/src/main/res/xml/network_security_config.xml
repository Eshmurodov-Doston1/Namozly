<?xml version="1.0" encoding="utf-8"?>
<!-- Barcha trafik HTTPS. Istisno: Saudiya teleradiosining zaxira oqim serveri faqat HTTP orqali ishlaydi. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">m.live.net.sa</domain>
    </domain-config>
</network-security-config>
